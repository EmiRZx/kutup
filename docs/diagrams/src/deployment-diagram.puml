@startuml deployment-diagram
!include style.iuml
title Kutup - Deployment diagram: a static web application; the whole library system, SQLite database included, runs in the user's browser

node "User's computer" <<device>> as pc {
  node "Web browser\n(Chrome, Edge, Firefox, Safari)" <<executionEnvironment>> as browser {

    node "JavaScript engine" <<executionEnvironment>> as js {
      component "Kutup library system" <<component>> as app {
        component "ui\n(React user interface)" as ui
        component "core\n(entities, services, rules)" as core
        component "db\n(SQLite repositories)" as dbc
      }
    }

    node "WebAssembly runtime" <<executionEnvironment>> as wasm {
      component "SQLite 3 engine\n(sql.js)" as sqlite
      database "Library database\n(in memory, schema version 4)" <<database>> as memdb
    }

    database "IndexedDB\n(database 'kutup', store 'saves')" <<storage>> as idb {
      artifact "library.sqlite" <<file>> as save
    }
  }

  folder "File system" <<storage>> as fs {
    artifact "kutup.sqlite\n(exported save file)" <<file>> as file
  }
}

node "Web server: GitHub Pages\n(emirzx.github.io)" <<device>> as server {
  node "Static file server (HTTPS)" <<executionEnvironment>> as web {
    artifact "index.html" <<document>> as html
    artifact "index-[hash].js" <<JavaScript bundle>> as bundle
    artifact "index-[hash].css" <<stylesheet>> as css
    artifact "sql-wasm-[hash].wasm" <<WebAssembly module>> as wasmfile
    artifact "font files (.woff2, .woff)" <<font>> as fonts
  }
}

' --- Inside the application ---
ui ..> core : calls services
ui ..> dbc : opens the library
dbc ..> core : implements repositories

' --- Communication paths ---
browser -- web : <<HTTPS>>\ndownloads the files once on load
dbc -- sqlite : <<WebAssembly calls>>\nSQL statements
sqlite -- memdb
app -- idb : <<IndexedDB API>>\nautosave after every change,\nrestore on start
app -- fs : <<download / file picker>>\nSave .sqlite / Open file

' --- Which file becomes what ---
bundle ..> app : <<manifest>>
wasmfile ..> sqlite : <<manifest>>

note bottom of server
  No application server and no server-side
  database: the server only hands out files.
  Each user's library is kept in their own browser.
end note
@enduml
