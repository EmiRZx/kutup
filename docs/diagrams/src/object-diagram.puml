@startuml object-diagram
!include style.iuml
title Kutup - Object diagram: the library on Friday 16 October 2026.\nBaran Yıldız owes a $15.00 damage fee for a copy of Emma he returned torn. He asks to borrow Hamlet;\nlending.checkCheckout() refuses: unpaid fines over the $5.00 limit.

package "Running system" {
  object "<u>library : Library</u>" as library
  object "<u>store : SqliteLibraryStore</u>" as store
  object "<u>database : SqliteDatabase</u>" as database
  object "<u>clock : StoredClock</u>" as clock {
    current = 2026-10-16
  }
  object "<u>lending : LendingService</u>" as lending
  object "<u>fines : FineService</u>" as fines
  object "<u>reservations : ReservationService</u>" as reservations
}

package "Rule book" {
  object "<u>policy : LendingPolicy</u>" as policy {
    dailyFine = 25
    maxFinePerLoan = 1000
    fineBlockThreshold = 500
    holdDays = 3
    blockWhenOverdue = true
    referenceLoansAllowed = false
    damageFee = 1500
    lostFee = 3000
  }
  object "<u>studentRules : MemberTypeRules</u>" as studentRules {
    maxLoans = 5
    loanDays = 14
    maxRenewals = 2
    cardValidityDays = 365
  }
  object "<u>staffRules : MemberTypeRules</u>" as staffRules {
    maxLoans = 10
    loanDays = 28
    maxRenewals = 3
    cardValidityDays = 730
  }
  object "<u>guestRules : MemberTypeRules</u>" as guestRules {
    maxLoans = 2
    loanDays = 7
    maxRenewals = 0
    cardValidityDays = 30
  }
}

package "Baran's account" {
  object "<u>baran : Member</u>" as baran {
    id = 9
    name = "Baran Yıldız"
    type = student
    email = "baran.yildiz@kutup.edu"
    status = active
    joinedOn = 2026-09-13
  }
  object "<u>card9 : LibraryCard</u>" as card9 {
    id = 9
    memberId = 9
    number = "84390079"
    issuedOn = 2026-09-13
    expiresOn = 2027-09-13
    status = active
  }
  object "<u>loan61 : Loan</u>" as loan61 {
    id = 61
    copyId = 4
    memberId = 9
    borrowedOn = 2026-10-04
    dueOn = 2026-10-18
    returnedOn = 2026-10-14
    renewals = 0
    overriddenViolations = []
    overrideNote = null
  }
  object "<u>fine16 : Fine</u>" as fine16 {
    id = 16
    memberId = 9
    loanId = 61
    amount = 1500
    reason = damage
    issuedOn = 2026-10-14
    status = unpaid
    settledOn = null
  }
}

package "Catalog" {
  object "<u>emmaCopy : BookCopy</u>" as emmaCopy {
    id = 4
    bookId = 2
    barcode = "B00002-01"
    status = in_repair
    condition = damaged
    acquiredOn = 2026-09-13
  }
  object "<u>emma : Book</u>" as emma {
    id = 2
    isbn = "9789900000020"
    title = "Emma"
    publishedYear = 1815
    genre = fiction
    referenceOnly = false
  }
  object "<u>austen : Author</u>" as austen {
    id = 1
    name = "Jane Austen"
    birthYear = null
  }
  object "<u>hamletCopy : BookCopy</u>" as hamletCopy {
    id = 55
    bookId = 37
    barcode = "B00037-01"
    status = available
    condition = good
    acquiredOn = 2026-09-13
  }
  object "<u>hamlet : Book</u>" as hamlet {
    id = 37
    isbn = "9789900000372"
    title = "Hamlet"
    publishedYear = 1603
    genre = drama
    referenceOnly = false
  }
  object "<u>shakespeare : Author</u>" as shakespeare {
    id = 29
    name = "William Shakespeare"
    birthYear = null
  }
}

package "The request and the answer" {
  object "<u>request : CheckoutRequest</u>" as request {
    memberId = 9
    cardNumber = "84390079"
    barcode = "B00037-01"
  }
  object "<u>assessment : CheckoutAssessment</u>" as assessment {
    allowed = false
    overridable = true
    dueOn = 2026-10-30
  }
  object "<u>unpaidFines : Violation</u>" as violation {
    code = FINES_OUTSTANDING
    message = "The member owes more in fines than the policy allows."
  }
}

' --- The running system ---
library -- store : store
library -- clock : clock
library *-- lending : lending
library *-- fines : fines
library *-- reservations : reservations
store -- database : db
clock -- database : calendar table
lending -- fines : fines
lending -- reservations : reservations
library ..> policy : «get» policy (loaded from the store)
policy *-- studentRules : student
policy *-- staffRules : staff
policy *-- guestRules : guest

' --- Baran's account and history ---
baran -- card9 : holds
baran -- loan61 : borrows
baran -- fine16 : owes
fine16 -- loan61 : charged for
loan61 -- emmaCopy : lent in
emmaCopy -- emma : copy of
emma -- austen : written by

' --- The book he wants ---
hamletCopy -- hamlet : copy of
hamlet -- shakespeare : written by

' --- checkCheckout(request) ---
lending ..> request : checkCheckout(request)
lending ..> assessment : returns
assessment -- baran : member
assessment -- card9 : card
assessment -- hamletCopy : copy
assessment -- hamlet : book
assessment -- violation : violations

note bottom of violation
  fine16.amount (1500) >= policy.fineBlockThreshold (500),
  so the loan is refused. A librarian could still
  override it with a written note (overridable = true).
end note
@enduml
